---
import BaseLayout from '../layouts/BaseLayout.astro';
import { teamMembers } from '../data/team';
---

<BaseLayout
  title="Notre Équipe d'Experts SEO | Stratègere Montpellier"
  description="Découvrez l'équipe d'experts SEO de Stratègere : Marie Dubois (fondatrice, ex-Google), Thomas Laurent, Sophie Martin et Julien Petit."
>
  <!-- Hero -->
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" style="margin-bottom: 1.5rem;">
        <a href="/" style="color: rgba(255,255,255,0.5);">Accueil</a>
        <span class="breadcrumb-sep">›</span>
        <span style="color: rgba(255,255,255,0.8);">Notre équipe</span>
      </nav>
      <div class="section-label" style="margin-bottom: 0.75rem;">L'équipe Stratègere</div>
      <h1 class="section-title-white" style="margin-bottom: 1rem;">Des experts qui font du SEO, pas des discours</h1>
      <p style="color: rgba(255,255,255,0.7); font-size: 1.125rem; max-width: 560px; line-height: 1.6;">
        Chaque membre de notre équipe est un praticien. Ils travaillent sur des campagnes clients réelles chaque jour et forment leurs recommandations sur des données, pas des théories.
      </p>
    </div>
  </section>

  <!-- Team Grid -->
  <section style="padding: 5rem 0;">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(520px, 1fr)); gap: 2rem;">
        {teamMembers.map(member => (
          <div style="background: #fff; border-radius: var(--radius-lg); border: 1px solid #f0f0f0; overflow: hidden; display: flex; gap: 0; transition: all 0.3s;" onmouseover="this.style.boxShadow='var(--shadow-hover)'; this.style.transform='translateY(-4px)'" onmouseout="this.style.boxShadow=''; this.style.transform=''">
            <div style="width: 180px; flex-shrink: 0; overflow: hidden;">
              <img src={member.image} alt={member.name} width="180" height="220" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy" />
            </div>
            <div style="padding: 2rem; flex: 1;">
              <div class="team-name" style="font-size: 1.25rem; text-align: left; margin-bottom: 0.25rem;">{member.name}</div>
              <div class="team-role" style="text-align: left; margin-bottom: 1rem;">{member.role}</div>
              <p style="color: #6b7280; font-size: 0.9rem; line-height: 1.6; margin-bottom: 1rem;">{member.bio}</p>
              <div style="display: flex; flex-wrap: wrap; gap: 0.375rem; margin-bottom: 1rem;">
                {member.expertise.map(e => (
                  <span class="tag-pill">{e}</span>
                ))}
              </div>
              <div style="display: flex; gap: 0.75rem;">
                <a href={member.linkedin} target="_blank" rel="noopener" style="font-size: 0.8125rem; color: var(--blue); font-weight: 600; text-decoration: none;">LinkedIn →</a>
                {member.twitter && <a href={member.twitter} target="_blank" rel="noopener" style="font-size: 0.8125rem; color: var(--blue); font-weight: 600; text-decoration: none;">Twitter →</a>}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Join us -->
  <section style="padding: 4rem 0; background: #f9fafb;">
    <div class="container" style="max-width: 700px; text-align: center;">
      <div class="section-label" style="margin-bottom: 0.75rem;">Rejoindre l'équipe</div>
      <h2 class="section-title" style="margin-bottom: 1rem;">Vous êtes expert SEO ou content marketing ?</h2>
      <p style="color: #6b7280; font-size: 1.0625rem; line-height: 1.6; margin-bottom: 2rem;">Nous sommes toujours à la recherche de profils exceptionnels. Si vous êtes passionné par le SEO et que vous aimez les défis, parlons-nous.</p>
      <a href="/contact" class="btn-primary">Envoyer votre candidature</a>
    </div>
  </section>
</BaseLayout>
