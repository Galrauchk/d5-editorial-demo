---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { caseStudies, getCaseStudyBySlug } from '../../data/caseStudies';

export async function getStaticPaths() {
  return caseStudies.map(cs => ({
    params: { slug: cs.slug },
    props: { cs }
  }));
}

const { cs } = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": `Étude de cas : ${cs.client}`,
  "description": cs.challenge,
  "image": cs.image,
  "author": { "@type": "Organization", "name": "Stratègere" }
};
---

<BaseLayout
  title={`Cas client : ${cs.client} — ${cs.sector} | Stratègere`}
  description={`Comment Stratègere a aidé ${cs.client} à transformer sa visibilité digitale. ${cs.results[0].metric} ${cs.results[0].value} en ${cs.results[0].description}.`}
  image={cs.image}
  schema={schema}
>
  <!-- Hero -->
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" style="margin-bottom: 1.5rem;">
        <a href="/" style="color: rgba(255,255,255,0.5);">Accueil</a>
        <span class="breadcrumb-sep">›</span>
        <a href="/cas-clients" style="color: rgba(255,255,255,0.5);">Cas clients</a>
        <span class="breadcrumb-sep">›</span>
        <span style="color: rgba(255,255,255,0.8);">{cs.client}</span>
      </nav>
      <div style="display: flex; gap: 0.75rem; margin-bottom: 1.25rem; flex-wrap: wrap;">
        <span style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--cyan);">{cs.sector}</span>
        <span style="color: rgba(255,255,255,0.3);">·</span>
        <span style="font-size: 0.75rem; color: rgba(255,255,255,0.6);">{cs.location}</span>
        <span style="color: rgba(255,255,255,0.3);">·</span>
        <span style="font-size: 0.75rem; color: rgba(255,255,255,0.6);">{cs.duration}</span>
      </div>
      <h1 class="section-title-white" style="margin-bottom: 0.75rem; max-width: 700px;">{cs.client}</h1>
      <p style="color: rgba(255,255,255,0.65); font-size: 1.0625rem; max-width: 600px; line-height: 1.6;">{cs.challenge}</p>
    </div>
    <div style="margin-top: 3rem; max-height: 400px; overflow: hidden;">
      <img src={cs.image} alt={cs.client} width="1280" height="400" style="width: 100%; height: 400px; object-fit: cover;" loading="eager" />
    </div>
  </section>

  <!-- Results -->
  <section style="background: var(--navy-light); border-bottom: 1px solid rgba(255,255,255,0.08);">
    <div class="container">
      <div style={`display: grid; grid-template-columns: repeat(${cs.results.length}, 1fr);`}>
        {cs.results.map((r, i) => (
          <div class="stat-item" style={i > 0 ? 'border-left: 1px solid rgba(255,255,255,0.08);' : ''}>
            <span class="stat-number">{r.metric}</span>
            <div style="font-size: 0.9375rem; color: rgba(255,255,255,0.8); margin-top: 0.25rem;">{r.value}</div>
            <div class="stat-label">{r.description}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Content -->
  <section style="padding: 5rem 0;">
    <div class="container" style="max-width: 900px;">
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; margin-bottom: 4rem;">
        <div>
          <h2 style="font-family: var(--font-serif); color: var(--navy); font-size: 1.5rem; margin-bottom: 1rem; padding-bottom: 0.75rem; border-bottom: 3px solid var(--cyan);">Le défi</h2>
          <p style="color: #374151; line-height: 1.75; font-size: 1.0rem;">{cs.challenge}</p>
        </div>
        <div>
          <h2 style="font-family: var(--font-serif); color: var(--navy); font-size: 1.5rem; margin-bottom: 1rem; padding-bottom: 0.75rem; border-bottom: 3px solid var(--orange);">Notre solution</h2>
          <p style="color: #374151; line-height: 1.75; font-size: 1.0rem;">{cs.solution}</p>
        </div>
      </div>

      <!-- Testimonial -->
      <div style="background: var(--navy); border-radius: var(--radius-lg); padding: 2.5rem; border: 1px solid rgba(0,229,255,0.2); position: relative; overflow: hidden;">
        <div style="font-size: 6rem; font-family: var(--font-serif); color: var(--cyan); opacity: 0.15; position: absolute; top: -1rem; left: 1.5rem; line-height: 1;">"</div>
        <blockquote style="margin: 0; position: relative;">
          <p style="color: rgba(255,255,255,0.9); font-size: 1.125rem; font-style: italic; line-height: 1.7; margin-bottom: 1.5rem;">"{cs.testimonial.quote}"</p>
          <footer>
            <div style="color: #fff; font-weight: 700; font-size: 1rem;">{cs.testimonial.author}</div>
            <div style="color: var(--cyan); font-size: 0.875rem; margin-top: 0.25rem;">{cs.testimonial.role}</div>
          </footer>
        </blockquote>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <div class="cta-band">
    <div class="container">
      <h2>Votre entreprise mérite les mêmes résultats</h2>
      <p>Discutons de votre situation et voyons comment nous pouvons vous aider à atteindre vos objectifs.</p>
      <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
        <a href="/audit-gratuit" class="btn-outline-dark">Audit gratuit</a>
        <a href="/cas-clients" style="display: inline-flex; align-items: center; color: var(--navy); font-weight: 600; gap: 0.5rem;">Voir d'autres cas →</a>
      </div>
    </div>
  </div>
</BaseLayout>
