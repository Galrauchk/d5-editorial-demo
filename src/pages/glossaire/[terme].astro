---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { glossaryTerms, getTermBySlug } from '../../data/glossary';
import { articles } from '../../data/articles';

export async function getStaticPaths() {
  return glossaryTerms.map(term => ({
    params: { terme: term.slug },
    props: { term }
  }));
}

const { term } = Astro.props;

const relatedArticlesList = articles.filter(a => term.relatedArticles.includes(a.slug));

const termSchema = {
  "@context": "https://schema.org",
  "@type": "DefinedTerm",
  "name": term.term,
  "description": term.definition,
  "inDefinedTermSet": "https://d5-editorial-demo.netlify.app/glossaire"
};
---

<BaseLayout
  title={`${term.term} : Définition et explication SEO | Stratègere`}
  description={term.shortDef + " Définition complète, exemples et ressources associées."}
  schema={termSchema}
>
  <!-- Hero -->
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" style="margin-bottom: 1.5rem;">
        <a href="/" style="color: rgba(255,255,255,0.5);">Accueil</a>
        <span class="breadcrumb-sep">›</span>
        <a href="/glossaire" style="color: rgba(255,255,255,0.5);">Glossaire</a>
        <span class="breadcrumb-sep">›</span>
        <span style="color: rgba(255,255,255,0.8);">{term.term}</span>
      </nav>
      <div class="section-label" style="margin-bottom: 0.75rem;">Définition SEO</div>
      <h1 class="section-title-white" style="margin-bottom: 1rem;">{term.term}</h1>
      <p style="color: rgba(255,255,255,0.7); font-size: 1.125rem; max-width: 600px; line-height: 1.6;">{term.shortDef}</p>
    </div>
  </section>

  <!-- Content -->
  <section style="padding: 4rem 0;">
    <div class="container">
      <div style="display: grid; grid-template-columns: 1fr 300px; gap: 4rem; align-items: start;">
        <!-- Main -->
        <div>
          <!-- Definition -->
          <div style="background: #fff; border-radius: var(--radius-lg); padding: 2.5rem; border: 1px solid #f0f0f0; margin-bottom: 2rem;">
            <h2 style="font-family: var(--font-serif); color: var(--navy); font-size: 1.5rem; margin-bottom: 1.25rem; padding-bottom: 0.75rem; border-bottom: 3px solid var(--cyan);">
              Définition complète
            </h2>
            <p style="color: #374151; font-size: 1.0625rem; line-height: 1.8;">{term.definition}</p>
          </div>

          <!-- Related Articles -->
          {relatedArticlesList.length > 0 && (
            <div style="background: #f9fafb; border-radius: var(--radius-lg); padding: 2rem; border: 1px solid #f0f0f0;">
              <h2 style="font-family: var(--font-serif); color: var(--navy); font-size: 1.25rem; margin-bottom: 1.25rem;">Articles liés</h2>
              <div style="display: flex; flex-direction: column; gap: 1rem;">
                {relatedArticlesList.map(article => (
                  <a href={`/blog/${article.slug}`} style="display: flex; gap: 1rem; text-decoration: none; padding: 0.875rem; background: #fff; border-radius: var(--radius); border: 1px solid #f0f0f0; transition: all 0.2s;" onmouseover="this.style.borderColor='var(--cyan)'" onmouseout="this.style.borderColor='#f0f0f0'">
                    <img src={article.image} alt={article.title} width="80" height="60" style="width: 80px; height: 60px; object-fit: cover; border-radius: 0.375rem; flex-shrink: 0;" />
                    <div>
                      <div style="font-family: var(--font-serif); color: var(--navy); font-size: 0.9375rem; font-weight: 700; line-height: 1.3; margin-bottom: 0.375rem;">{article.title}</div>
                      <div style="font-size: 0.8125rem; color: #9ca3af;">{article.readTime} min de lecture</div>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>

        <!-- Sidebar -->
        <div style="position: sticky; top: 5rem;">
          <!-- Related terms -->
          {term.relatedTerms.length > 0 && (
            <div style="background: #f9fafb; border-radius: var(--radius-lg); padding: 1.5rem; border: 1px solid #f0f0f0; margin-bottom: 1.5rem;">
              <h3 style="font-family: var(--font-serif); color: var(--navy); font-size: 1rem; margin-bottom: 1rem;">Termes associés</h3>
              <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                {term.relatedTerms.map(slug => {
                  const related = glossaryTerms.find(t => t.slug === slug);
                  return related ? (
                    <a href={`/glossaire/${related.slug}`} style="font-size: 0.875rem; color: var(--blue); padding: 0.5rem; background: #fff; border-radius: 0.375rem; border: 1px solid #f0f0f0; display: block; transition: all 0.2s; text-decoration: none;" onmouseover="this.style.borderColor='var(--cyan)'" onmouseout="this.style.borderColor='#f0f0f0'">
                      → {related.term}
                    </a>
                  ) : null;
                })}
              </div>
            </div>
          )}

          <!-- CTA -->
          <div style="background: var(--gradient-hero); border-radius: var(--radius-lg); padding: 1.5rem; border: 1px solid rgba(0,229,255,0.2);">
            <div style="font-size: 1.5rem; margin-bottom: 0.75rem;">📚</div>
            <h3 style="font-family: var(--font-serif); color: #fff; font-size: 1rem; margin-bottom: 0.5rem;">Voir tout le glossaire</h3>
            <p style="color: rgba(255,255,255,0.65); font-size: 0.8125rem; margin-bottom: 1rem;">{glossaryTerms.length} termes SEO définis.</p>
            <a href="/glossaire" class="btn-secondary" style="width: 100%; justify-content: center; font-size: 0.8125rem; padding: 0.5rem 1rem;">Parcourir le glossaire</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
